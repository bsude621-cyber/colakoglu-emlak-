---
// "Muğla emlak" hub sayfası.
//
// NEDEN: GSC verisinde "muğla emlak" için sıfır gösterim var ve bu arama için
// ana sayfa dışında hedef sayfa yoktu. Ana sayfa marka sorgularında (poz ~6)
// çalışıyor; ona ayrıca il geneli anahtar kelimeyi yüklemek ikisini de zayıflatır.
// Ayrıca /bolgeler/ adresi 404 döndürüyordu — ilçe sayfalarının URL hiyerarşisinde
// üst düğüm boştu ve breadcrumb'lar ana sayfa çapasına (/#bolgeler) gidiyordu.
// Bu sayfa iki boşluğu birden kapatır: il geneli hedef + hiyerarşinin üst düğümü.
//
// İçerik tamamı regions.ts ve neighborhoods.ts'ten türetilir — uydurma veri yok.
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { regions } from "../../data/regions";
import { neighborhoods } from "../../data/neighborhoods";
import { site, services } from "../../data/config";
import { webPageSchema } from "../../lib/page-schema.mjs";
import { contentModified, contentModifiedText } from "../../lib/content-dates.mjs";
import { inPlace } from "../../lib/turkish.mjs";

const canonical = `${site.url}/bolgeler/`;
const title = `Muğla Emlak — 13 İlçede Satılık ve Kiralık | ${site.name}`;
const description =
  "Muğla'nın 13 ilçesinde satılık ve kiralık konut, villa, arsa, tarım arazisi ve ticari gayrimenkul. 1994'ten beri Muğla'nın ilk emlak ofisi. Ara: 0252 212 50 15";

// Tarih, sayfayı besleyen veri dosyalarının en yenisinden okunur
const modified = [
  contentModified("src/data/regions.ts"),
  contentModified("src/data/neighborhoods.ts"),
].sort().at(-1)!;
const modifiedText = contentModifiedText("src/data/regions.ts");

// İlçe → o ilçenin mahalle sayfaları
const nbByRegion = new Map(
  regions.map((r) => [r.slug, neighborhoods.filter((n) => n.parent === r.slug)]),
);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Ana Sayfa", item: site.url },
    { "@type": "ListItem", position: 2, name: "Muğla Bölgeleri", item: canonical },
  ],
};

// 13 ilçe tek listede — Google için sayfanın ana varlığı
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${canonical}#ilceler`,
  name: "Muğla ilçeleri — gayrimenkul bölge sayfaları",
  numberOfItems: regions.length,
  itemListElement: regions.map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${r.name} emlak`,
    url: `${site.url}/bolgeler/${r.slug}/`,
  })),
};

// Sorular yalnızca veri dosyalarındaki gerçek alanlardan kurulur.
const faq = [
  {
    q: "Çolakoğlu Emlak Muğla'nın hangi ilçelerinde hizmet veriyor?",
    a: `Muğla'nın 13 ilçesinin tamamında: ${regions
      .map((r) => r.name)
      .join(", ")}. Her ilçe için ayrı bölge sayfası yayındadır; ${neighborhoods.length} mahalle için de ayrıca hyperlocal sayfa bulunur.`,
  },
  {
    q: "Muğla'da tarım arazisi hangi ilçelerde öne çıkıyor?",
    a: `Tarım arazisi segmenti ${regions
      .filter((r) => r.segments.some((s) => /tarım/i.test(s)))
      .map((r) => r.name)
      .join(", ")} ilçelerinde öne çıkar. Tarım vasıflı arazilerde 5403 sayılı Toprak Koruma ve Arazi Kullanımı Kanunu kapsamındaki bölünme ve kullanım kısıtları alım öncesinde değerlendirilmelidir.`,
  },
  {
    q: "Muğla'da villa pazarı hangi ilçelerde yoğunlaşıyor?",
    a: `Villa segmenti ${regions
      .filter((r) => r.segments.some((s) => /villa/i.test(s)))
      .map((r) => r.name)
      .join(", ")} ilçelerinde yoğunlaşır. Kıyıya yakın parsellerde kıyı kanunu kapsamındaki kısıtlar ve 1/1000 ölçekli imar planları belirleyicidir.`,
  },
  {
    q: "Muğla'da hangi ilçe hangi yatırım hedefine uygun?",
    a: "Muğla tek bir piyasa değildir. Kıyı ilçelerinde tatil amaçlı konut ve kısa dönem kiralama, il merkezinde (Menteşe) yıl boyu kiralama ve öğrenci konutu, iç ilçelerde tarım arazisi ve bağ-bahçe öne çıkar. Bölge seçimi yatırım hedefi (sermaye değer artışı, kira getirisi, tarımsal getiri) netleştirildikten sonra anlamlı olur.",
  },
  {
    q: "Bir ilçede arazi alırken hangi kontroller yapılmalı?",
    a: "İmar durumu belgesi (belediyenin İmar Müdürlüğünden), tapu kaydı ve şerhler, kadastro sınırları, arazinin vasfı (tarla, zeytinlik, orman, mera) ve varsa koruma statüsü kontrol edilmelidir. Muğla'da zeytinlik vasfı ve SİT alanları en sık karşılaşılan iki kısıttır; Köyceğiz-Dalyan ve Gökova gibi Özel Çevre Koruma Bölgelerinde yapılaşma koşulları ayrıca farklı işler.",
  },
  {
    q: "Yabancı uyruklu alıcılar Muğla'da gayrimenkul alabilir mi?",
    a: "Evet. Süreç 2644 sayılı Tapu Kanunu'nun 35. maddesi kapsamında yürür: vergi numarası, askeri yasak bölge sorgusu, SPK yetkili kuruluşça düzenlenen taşınmaz değerleme raporu ve Web-Tapu randevusu adımlarını içerir. Bir yabancı gerçek kişi ülke genelinde 30 hektara kadar taşınmaz edinebilir; bir ilçedeki edinim o ilçenin özel mülkiyet alanının %10'unu aşamaz.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${canonical}#faq`,
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const webPage = webPageSchema({
  siteUrl: site.url,
  canonical,
  name: "Muğla emlak — 13 ilçede yerel uzmanlık",
  description,
  dateModified: modified,
  mainEntityId: `${canonical}#ilceler`,
  speakable: ["h1", ".hub-tldr-text"],
});
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[breadcrumb, webPage, itemList, faqSchema]}
>
  <Header />
  <main id="main" class="hub-page">
    <header class="hub-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Sayfa konumu">
          <a href="/">Ana Sayfa</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Muğla Bölgeleri</span>
        </nav>
        <p class="eyebrow">
          Muğla · Bölge Rehberi · güncelleme{" "}
          <time datetime={modified}>{modifiedText}</time>
        </p>
        <h1>Muğla emlak — 13 ilçede yerel uzmanlık</h1>
        <p class="hub-intro">
          Muğla tek bir gayrimenkul piyasası değil. Kıyı ilçeleriyle iç ilçeler
          farklı talep, farklı yapılaşma rejimi ve farklı yatırım karakteri
          taşır. Çolakoğlu Emlak {site.experienceYears} yıldır ilin tamamında
          çalışır; her ilçe için ayrı bölge sayfası, {neighborhoods.length} mahalle
          için ayrı hyperlocal sayfa yayındadır.
        </p>
        <div class="hub-actions">
          <a href="/ilanlar/" class="btn btn-primary">Güncel ilanları görün</a>
          <a href={`tel:${site.contact.phone}`} class="btn btn-ghost">
            {site.contact.phoneDisplay}
          </a>
        </div>
      </div>
    </header>

    <!-- TL;DR — AI Overview / snippet için izole anlamlı özet -->
    <section class="section hub-tldr-section">
      <div class="container">
        <aside class="hub-tldr" aria-label="Özet">
          <p class="hub-tldr-label">Kısa Özet</p>
          <p class="hub-tldr-text">
            <strong>
              Muğla'nın 13 ilçesi gayrimenkul açısından üç ana gruba ayrılır:
              Bodrum, Marmaris, Fethiye, Datça ve Ula'nın kıyı kesimlerinde
              tatil amaçlı konut ve villa; Menteşe'de yıl boyu kiralama, öğrenci
              konutu ve ticari gayrimenkul; Milas, Köyceğiz, Ortaca, Dalaman,
              Yatağan, Kavaklıdere ve Seydikemer'de tarım arazisi, zeytinlik,
              sera ve bağ-bahçe öne çıkar.
            </strong>
          </p>
        </aside>
      </div>
    </section>

    <!-- Karşılaştırma tablosu — "hangi ilçe neye uygun" sorgusunun doğrudan cevabı -->
    <section class="section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Karşılaştırma</p>
          <h2>Hangi ilçede hangi gayrimenkul öne çıkıyor?</h2>
        </header>
        <div class="hub-table-wrap">
          <table class="hub-table">
            <thead>
              <tr>
                <th scope="col">İlçe</th>
                <th scope="col">Öne çıkan segmentler</th>
                <th scope="col">Mahalle sayfaları</th>
              </tr>
            </thead>
            <tbody>
              {
                regions.map((r) => (
                  <tr>
                    <th scope="row">
                      <a href={`/bolgeler/${r.slug}/`}>{r.name} emlak</a>
                    </th>
                    <td>{r.segments.join(", ")}</td>
                    <td>
                      {nbByRegion.get(r.slug)!.length > 0
                        ? nbByRegion
                            .get(r.slug)!
                            .map((n, i) => (
                              <>
                                {i > 0 && ", "}
                                <a href={`/bolgeler/${n.parent}/${n.slug}/`}>{n.name}</a>
                              </>
                            ))
                        : "—"}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- İlçe kartları — her biri kendi özetiyle -->
    <section class="section section-alt">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">İlçeler</p>
          <h2>Muğla'nın 13 ilçesi</h2>
        </header>
        <div class="hub-grid">
          {
            regions.map((r) => (
              <article class="hub-card">
                <h3>
                  <a href={`/bolgeler/${r.slug}/`}>{r.name} emlak</a>
                </h3>
                <p class="hub-card-text">{r.tldr}</p>
                <p class="hub-card-segs">{r.segments.slice(0, 4).join(" · ")}</p>
                <a href={`/bolgeler/${r.slug}/`} class="hub-card-go">
                  {inPlace(r.name)} gayrimenkul piyasası →
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Hizmetler — hub'dan dönüşüm sayfalarına akış -->
    <section class="section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Hizmetler</p>
          <h2>Bölge fark etmeksizin sunulan hizmetler</h2>
        </header>
        <div class="hub-grid hub-grid-services">
          {
            services.map((s) => (
              <article class="hub-card">
                <h3>
                  <a href={`/hizmetler/${s.slug}/`}>{s.name}</a>
                </h3>
                <p class="hub-card-text">{s.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SSS — FAQPage schema ile birebir aynı içerik -->
    <section class="section section-alt">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Sıkça Sorulanlar</p>
          <h2>Muğla'da gayrimenkul hakkında sık sorulanlar</h2>
        </header>
        <div class="hub-faq">
          {
            faq.map((item) => (
              <details class="faq-item">
                <summary>
                  <span class="faq-q">{item.q}</span>
                  <span class="faq-toggle" aria-hidden="true">+</span>
                </summary>
                <div class="faq-a">
                  <p>{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section hub-cta-section">
      <div class="container hub-cta">
        <p class="eyebrow">İletişim</p>
        <h2>Muğla'da gayrimenkul mü arıyorsunuz?</h2>
        <p>
          Hangi ilçede olduğunuzu söyleyin; bütçenize ve beklentinize uygun
          seçenekleri portföyümüzden çıkaralım.
        </p>
        <a href="/#iletisim" class="btn btn-primary">İletişim formunu doldur</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hub-hero {
    padding: calc(var(--header-h) + 3rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    background: var(--color-wood-deep);
  }

  .hub-hero .eyebrow {
    color: var(--color-gold-bright);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.58);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.58);
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-gold-bright);
  }

  .breadcrumb [aria-current="page"] {
    color: #fff;
  }

  .hub-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 4.8vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fff;
    margin: 0 0 1rem;
    max-width: 20ch;
  }

  .hub-intro {
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 1.75rem;
  }

  .hub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hub-hero .btn-ghost {
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  /* ── Özet kutusu ── */
  .hub-tldr-section {
    padding-bottom: 0;
  }

  .hub-tldr {
    background: var(--color-navy);
    color: #fff;
    padding: 1.6rem 1.85rem;
    border-radius: var(--radius-md);
  }

  .hub-tldr-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold-bright);
    margin: 0 0 0.5rem;
  }

  .hub-tldr-text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
  }

  .hub-tldr-text strong {
    font-weight: 500;
  }

  /* ── Karşılaştırma tablosu ── */
  .hub-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .hub-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .hub-table th,
  .hub-table td {
    padding: 0.85rem 1.1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-line);
  }

  .hub-table thead th {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-eyebrow);
    background: var(--color-bg-alt);
  }

  .hub-table tbody tr:last-child th,
  .hub-table tbody tr:last-child td {
    border-bottom: none;
  }

  .hub-table tbody th {
    font-weight: 700;
    white-space: nowrap;
  }

  .hub-table td {
    color: var(--color-ink-muted);
  }

  /* ── İlçe / hizmet kartları ── */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.1rem;
  }

  .hub-grid-services {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .hub-card h3 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .hub-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .hub-card h3 a:hover {
    color: var(--color-gold-deep);
  }

  .hub-card-text {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .hub-card-segs {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-eyebrow);
  }

  .hub-card-go {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ── SSS ── */
  .hub-faq {
    max-width: 820px;
  }

  .faq-item {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .faq-item[open] {
    border-color: var(--color-navy);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-weight: 600;
    color: var(--color-ink);
  }

  .faq-toggle {
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--color-gold);
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-out);
  }

  .faq-item[open] .faq-toggle {
    transform: rotate(45deg);
  }

  .faq-a {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-a p {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  /* ── Kapanış ── */
  .hub-cta-section {
    background: var(--color-wood-deep);
  }

  .hub-cta {
    text-align: center;
    max-width: 640px;
  }

  .hub-cta .eyebrow {
    color: var(--color-gold-bright);
  }

  .hub-cta h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #fff;
    margin: 0 0 0.85rem;
  }

  .hub-cta p {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 1.6rem;
  }
</style>
